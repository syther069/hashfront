{
  "name": "@hashfront/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hashfront status page, embeddable badge and maintainer approve page",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build && vite build -c vite.api.config.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "node --test \"test/*.test.ts\"",
    "test:e2e": "node --test \"test/*.e2e.ts\""
  },
  "dependencies": {
    "@hashfront/circuits": "0.1.0",
    "@hashfront/cli": "0.1.0",
    "@hashfront/okx": "0.1.0",
    "@hashfront/watcher": "0.1.0",
    "@okxconnect/ui": "1.9.1",
    "@tanstack/react-query": "5.106.0",
    "ox": "1.8.13",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "viem": "2.57.16",
    "wagmi": "3.7.11"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "vite": "8.3.6"
  },
  "engines": {
    "node": ">=22.18"
  }
}
